{
	"name": "Controller Workbench",
	"mode": "operate",
	"platform": "macOS",
	"tokens": {
		"spacing": {
			"compact": 8,
			"control": 12,
			"section": 18,
			"pane": 24
		},
		"window": {
			"settingsDefault": [960, 640],
			"settingsMinimum": [720, 480],
			"inputTestDefault": [900, 620],
			"inputTestMinimum": [700, 500]
		},
		"breakpoints": {
			"workspaceStack": 620,
			"settingsStack": 650,
			"inputTestRegular": 780,
			"inputTestWide": 1060
		},
		"colors": {
			"surface": "NSColor.windowBackgroundColor",
			"secondarySurface": "NSColor.controlBackgroundColor",
			"separator": "NSColor.separatorColor",
			"text": "NSColor.labelColor",
			"secondaryText": "NSColor.secondaryLabelColor",
			"success": "NSColor.systemGreen",
			"caution": "NSColor.systemOrange",
			"failure": "NSColor.systemRed"
		}
	},
	"components": [
		"source-list row",
		"page header",
		"status card",
		"data row",
		"workspace list/detail",
		"fixed 28-point list glyph column",
		"focused profile section navigation",
		"persistent profile editor footer",
		"diagnostic section",
		"console workspace"
	],
	"constraints": [
		"native semantic materials",
		"controller-family accents only for identity or live state",
		"content-driven card heights",
		"keyboard and VoiceOver support",
		"light and dark appearance support",
		"no representative controller artwork or silhouettes",
		"profile section choice is session-only and draft-neutral"
	]
}
